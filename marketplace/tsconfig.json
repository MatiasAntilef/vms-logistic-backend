{
  "compilerOptions": {
    "target": "es2022",
    "strict": true,
    "noEmit": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["handlers/**/*.ts"]
}
